# =============================================================================
# ClipForge environment configuration
#
# Copy to `.env` and fill in what your deployment needs. Everything here has a
# safe development default; only the values marked REQUIRED IN PRODUCTION must
# be set before going live.
# =============================================================================

# ------------------------------------------------------------------- general ---
ENVIRONMENT=development                    # development | test | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false                             # true in production (structured logs)

# ------------------------------------------------------------------ security ---
# REQUIRED IN PRODUCTION: random 32+ byte secrets. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=10080             # session cookie lifetime (7 days)
SESSION_COOKIE_NAME=clipforge_session
CSRF_COOKIE_NAME=clipforge_csrf
CSRF_HEADER_NAME=x-csrf-token
COOKIE_SECURE=false                        # true behind HTTPS
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
PASSWORD_MIN_LENGTH=8
# Fernet key used to encrypt provider API keys at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------------------------------------------------------------------- data ---
DATABASE_URL=postgresql+psycopg://clipforge:clipforge@postgres:5432/clipforge
# Local development without PostgreSQL: DATABASE_URL=sqlite:///./clipforge-dev.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
AUTO_CREATE_TABLES=true                    # production: run `alembic upgrade head` instead

REDIS_URL=redis://redis:6379/0
QUEUE_BACKEND=auto                         # auto | redis | memory
CACHE_BACKEND=auto                         # auto | redis | memory

# ------------------------------------------------------------------- workers ---
WORKER_INLINE=true                         # API process also runs a worker (dev/single box)
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=0.5
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_SECONDS=5
WORKER_JOB_TIMEOUT_MINUTES=90
RENDER_CONCURRENCY=1

# ------------------------------------------------------------------- storage ---
STORAGE_BACKEND=auto                       # auto | local | s3
STORAGE_LOCAL_ROOT=.data/storage
STORAGE_MAX_BYTES=21474836480              # 20 GB per account
S3_ENDPOINT=                               # http://minio:9000 for MinIO/R2
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=clipforge
S3_PREFIX=media
S3_PUBLIC_BASE_URL=                        # CDN base URL, optional
S3_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=3600

# --------------------------------------------------------------------- media ---
MEDIA_FFMPEG_PATH=                         # auto-detected (PATH, then imageio-ffmpeg)
MEDIA_FFPROBE_PATH=                        # optional: PyAV probing is used when absent
MEDIA_MAX_UPLOAD_BYTES=10737418240         # 10 GB
MEDIA_MIN_UPLOAD_BYTES=1024
MEDIA_ALLOWED_EXTENSIONS=mp4,mov,mkv,webm,m4v,avi,mp3,m4a,wav,flac,ogg,ts
MEDIA_ALLOWED_MIME_PREFIXES=video/,audio/
MEDIA_FRAME_SAMPLE_FPS=2.0
MEDIA_MAX_ANALYSIS_FRAMES=900
UPLOAD_CHUNK_SIZE=8388608                  # 8 MiB chunks
UPLOAD_SESSION_TTL_MINUTES=1440
DEFAULT_ASPECT_RATIO=9:16
FONT_DIRECTORY=/usr/share/fonts

# ------------------------------------------------------------------- renders ---
RENDER_VIDEO_CODEC=libx264
RENDER_AUDIO_CODEC=aac
RENDER_PRESET=medium
RENDER_CRF=20
RENDER_DEFAULT_BITRATE=8M
RENDER_AUDIO_BITRATE=192k
RENDER_THREADS=0                           # 0 = let FFmpeg decide

# --------------------------------------------------------------- AI providers ---
# Every provider is behind an interface; pick one per task. `auto` selects the
# best available option and reports honestly when nothing can run.
AI_TRANSCRIPTION_PROVIDER=auto             # auto | faster-whisper | openai | custom | none
AI_SCRIPT_ALIGNMENT=true                   # align a pasted script to the audio for exact timings
AI_LLM_PROVIDER=auto                       # auto | openai | gemini | anthropic | custom | ollama | none
AI_EMBEDDING_PROVIDER=auto                 # auto | sentence-transformers | tfidf
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

WHISPER_MODEL=base                         # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto                        # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_DOWNLOAD_ROOT=
WHISPER_LOCAL_FILES_ONLY=false
WHISPER_ALLOW_FALLBACK=true

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

CUSTOM_API_KEY=                            # any OpenAI-compatible endpoint (vLLM, LM Studio, ...)
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# --------------------------------------------------- vision / smart framing ---
VISION_ENABLED=true
VISION_FACE_DETECTOR=auto                  # auto | haar | mediapipe | yunet | none
VISION_YUNET_MODEL=

# ------------------------------------------- Rust processor (optional sidecar) ---
PROCESSOR_ENABLED=false                    # the web app never depends on it
PROCESSOR_URL=                             # http://processor:8100 when running as a service
PROCESSOR_BINARY=                          # or a path to the CLI binary
PROCESSOR_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------- frontends ---
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
WEBSOCKET_URL=                             # derived from API_URL when empty
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------- rate limits ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_UPLOAD_REQUESTS=120

# ------------------------------------------------------------------ billing ---
BILLING_PROVIDER=manual                    # manual | stripe | paystack | flutterwave
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
BILLING_SUCCESS_URL=http://localhost:5173/settings?checkout=success

# ---------------------------------------------------------------------- ops ---
SENTRY_DSN=
METRICS_ENABLED=true
SEED_DEMO_DATA=false
